# Archivos que NO van dentro del .vsix (solo sirven para desarrollar).
.vscode/**
.gitignore
**/*.vsix
**/*.map
test/**
# Las imágenes de presentación se ven desde GitHub, no van dentro de la extensión.
docs/**
# Solo le avisa a Node (en las pruebas) que media/ usa módulos ES; el visor no lo necesita.
media/package.json

# De pdfjs-dist (37 MB) solo usamos dos archivos y su licencia.
node_modules/**
!node_modules/pdfjs-dist/package.json
!node_modules/pdfjs-dist/LICENSE
!node_modules/pdfjs-dist/build/pdf.min.mjs
!node_modules/pdfjs-dist/build/pdf.worker.min.mjs

# De pdf-lib (para exportar el PDF con resaltados) solo su archivo único y su licencia.
!node_modules/pdf-lib/package.json
!node_modules/pdf-lib/LICENSE.md
!node_modules/pdf-lib/dist/pdf-lib.min.js
